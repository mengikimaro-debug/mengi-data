{
  "name": "mengi-data",
  "private": true,
  "version": "2.1.0",
  "description": "Mengidata - dashibodi ya fedha ya biashara, inayofanya kazi bila intaneti kwenye Android.",
  "type": "module",
  "scripts": {
    "dev": "node --require ./scripts/vite-sandbox-shim.cjs ./node_modules/vite/bin/vite.js --port=3000 --host=0.0.0.0",
    "build": "node --require ./scripts/vite-sandbox-shim.cjs ./node_modules/vite/bin/vite.js build",
    "build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "preview": "node --require ./scripts/vite-sandbox-shim.cjs ./node_modules/vite/bin/vite.js preview",
    "lint": "tsc --noEmit",
    "icons": "python scripts/generate-icons.py"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
