<?xml version="1.0" encoding="utf-8"?>
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Declaring force-lock ensures Android 13–16 recognizes and activates this Device Admin
         in AddDeviceAdminActivity so standard 1-tap uninstall is blocked at the OS level. -->
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
